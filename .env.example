# Base de données PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# Activer TLS pour une base distante. La vérification stricte dépend du certificat fourni.
PG_SSL=true
PG_SSL_REJECT_UNAUTHORIZED=false

# JWT — 32 caractères minimum en production
JWT_SECRET=votre_secret_jwt_tres_long_et_aleatoire_32_caracteres_minimum

# OpenAI
OPENAI_API_KEY=sk-proj-...
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Football Data API
FOOTBALL_DATA_API_KEY=votre_cle_football_data

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_AI_PLUS_PRICE_ID=price_...
STRIPE_AI_PREMIUM_PRICE_ID=price_...

# Messagerie SMTP
SMTP_PASSWORD=votre_mot_de_passe_smtp

# Frontend
FRONTEND_URL=https://prono-sport.io

# Port
PORT=3002
